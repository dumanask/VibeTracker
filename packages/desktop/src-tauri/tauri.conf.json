{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeTracker",
  "version": "0.1.1",
  "identifier": "dev.vibetracker.desktop",
  "build": {
    "beforeBuildCommand": "node ../../scripts/make-icon.mjs && node ../../scripts/desktop-stage.mjs",
    "beforeDevCommand": "node ../../scripts/make-icon.mjs && node ../../scripts/desktop-stage.mjs",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "runtime/**/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A control room for multi-agent vibe coding",
    "longDescription": "Watches Claude Code, Codex, opencode, Cline and editor agents on one dashboard. It never writes a file into a project, never talks to an agent, and never goes to the network.",
    "copyright": "Copyright 2026 VibeTracker contributors. Apache-2.0.",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
