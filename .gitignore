packages/desktop/src-tauri/gen/

# Generated by scripts/desktop-stage.mjs: a whole Node runtime plus a copy of
# our own sources. Regenerated on every build, on the platform being built for,
# so committing it would mean an 85 MB binary in history that is wrong on two
# platforms out of three.
packages/desktop/src-tauri/runtime/

# Generated by scripts/make-icon.mjs. Drawn in code precisely so the repository
# does not carry image blobs nobody can review.
packages/desktop/src-tauri/icons/
